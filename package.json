{
  "name": "fleetwise-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/sentry-build.mjs",
    "build:angular": "ng build",
    "build:prebuilt-preview": "node scripts/sentry-prebuilt.mjs prepare",
    "deploy:prebuilt-preview": "node scripts/sentry-prebuilt.mjs deploy-preview",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:build": "node --test scripts/sentry-build.test.mjs",
    "test:browser-rejection": "node --test scripts/sentry-browser-rejection.test.mjs",
    "verify:sentry-privacy": "node scripts/sentry-privacy-preflight.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^21.2.10",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.10",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@sentry/angular": "11.8.0",
    "@stomp/stompjs": "^7.3.0",
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "ng2-charts": "^10.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.10",
    "@angular/cli": "^21.2.10",
    "@angular/compiler-cli": "^21.2.0",
    "@sentry/cli": "3.8.0",
    "@types/leaflet": "^1.9.21",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "webpack-bundle-analyzer": "^5.3.1"
  }
}
